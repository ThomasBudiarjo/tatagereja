# Copy to deploy/.env and adjust before running docker compose.
APP_URL=https://church.example.com
SERVER_NAME=Grace Community Church
REGISTRATION_MODE=invite_only
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CORS_ORIGINS=
SESSION_TTL_DAYS=30
# A session unused for this many days ends (at most SESSION_TTL_DAYS).
SESSION_IDLE_DAYS=7
# Lifetime of access tokens for apps on another origin (they renew with a rotating refresh token).
ACCESS_TOKEN_TTL_MINUTES=15
# Reverse proxies in front of the container (TLS terminator). 0 when the container is reached directly.
TRUST_PROXY=1
# Key that encrypts confidential fields (two-step secrets, national ID numbers, medical and private
# notes, pastoral care notes, check-in alerts). Create one with: openssl rand -base64 32
# Empty keeps a key file (.tatagereja.key) next to the database in the data volume.
ENCRYPTION_KEY=
# Older keys still accepted for reading while rotating (comma-separated); see docs/SECURITY.md.
ENCRYPTION_PREVIOUS_KEYS=
# Only for servers set up before ENCRYPTION_KEY existed: the old two-factor key, read once to migrate.
TWO_FACTOR_ENCRYPTION_KEY=
