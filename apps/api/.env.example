# Address and port the API listens on
HOST=0.0.0.0
PORT=3000

# SQLite database file (created automatically). Use ":memory:" for an ephemeral database.
DATABASE_PATH=./data/tatagereja.db

# Registration mode: public | invite_only | disabled
REGISTRATION_MODE=public

# Optional Cloudflare Turnstile bot protection for account registration
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Comma-separated list of allowed browser origins (leave empty to allow any origin)
CORS_ORIGINS=

# Absolute session lifetime in days: a session ends this long after sign-in, however it is used
SESSION_TTL_DAYS=30

# Idle timeout in days: a session not used for this long ends (at most SESSION_TTL_DAYS)
SESSION_IDLE_DAYS=7

# Lifetime of access tokens for apps on another origin; they renew with a rotating refresh token
ACCESS_TOKEN_TTL_MINUTES=15

# Directory of the built web app to serve (leave empty to run API only)
WEB_DIST_DIR=

# Public URL of the web app, used to build invitation links
APP_URL=http://localhost:5173

# Largest accepted request body in KiB (larger requests are refused with 413)
MAX_BODY_KB=2048

# Reverse proxies in front of the API (0 = none). With 1 or more, the client address is read from
# X-Forwarded-For as written by the proxies; without them the header is ignored.
TRUST_PROXY=0

# Key that encrypts confidential fields at rest (AES-256-GCM): two-step secrets, national ID
# numbers, medical and private notes, pastoral care notes and check-in alerts. 32 random bytes in
# base64 or hex, optionally with an id: `2026a:<base64>`. Create one with: openssl rand -base64 32
# An invalid key stops the server at startup. Leave empty to use a key file created next to the
# database (.tatagereja.key); either way keep the key with your backups, a database restored
# without it cannot be read.
ENCRYPTION_KEY=

# Older keys still read while rotating, comma-separated. After `bun run db:rotate-key` has
# re-encrypted everything with ENCRYPTION_KEY they can be removed. See docs/SECURITY.md.
ENCRYPTION_PREVIOUS_KEYS=

# Only for servers set up before ENCRYPTION_KEY: the old key of two-step secrets (or the
# .tatagereja-2fa.key file next to the database), read at startup to re-encrypt those secrets.
TWO_FACTOR_ENCRYPTION_KEY=
