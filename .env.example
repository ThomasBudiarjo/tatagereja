PORT=8080
APP_ENV=development
SQLITE_PATH=./data/tatagereja.db
# Local file replica (path or file:// URL — resolved to absolute on boot)
LITESTREAM_REPLICA_URL=./data/replica
LOG_LEVEL=debug

# Cloudflare Turnstile (signup bot protection)
# Leave empty in dev to bypass verification.
# Test keys (always pass): site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Production (S3-compatible — e.g. Cloudflare R2):
# APP_ENV=production
# SQLITE_PATH=/tmp/tatagereja.db
# LITESTREAM_REPLICA_URL=s3://your-bucket/tatagereja
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=auto
# AWS_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
