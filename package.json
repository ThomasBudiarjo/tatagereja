{
  "name": "tatagereja",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.9",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=25.0.0"
  },
  "scripts": {
    "mobile": "npm run start --workspace @tatagereja/mobile",
    "mobile:android": "npm run android --workspace @tatagereja/mobile",
    "mobile:ios": "npm run ios --workspace @tatagereja/mobile",
    "backend": "npm run dev --workspace @tatagereja/backend",
    "backend:install": "npm run install:pocketbase --workspace @tatagereja/backend",
    "check": "npm run check --workspaces --if-present"
  }
}
